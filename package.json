{
  "name": "wassl-system",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "security:scan": "node tests/security/repository_scan.cjs",
    "test:security": "node --test tests/security/*.test.cjs",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:build": "npm --prefix backend run build",
    "test": "npm run backend:typecheck && npm run test:security",
    "build": "npm run backend:build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "serverless-http": "^3.2.0"
  }
}
